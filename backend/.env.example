FLASK_ENV=development
PORT=8080
CACHE_TTL_SECONDS=300
# Optional licensed market provider. Must return the documented prices object.
PRICE_PROVIDER_URL=
PRICE_PROVIDER_API_KEY=
# Optional Google Places API key for India city search.
GOOGLE_PLACES_API_KEY=
# Optional weather provider; Open-Meteo is used by default and needs no key.
WEATHER_PROVIDER_URL=https://api.open-meteo.com/v1/forecast
