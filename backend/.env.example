FLASK_ENV=development
PORT=8080
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MIN=120
# Comma-separated list of allowed browser origins for the API, or * for any.
ALLOWED_ORIGINS=*

# Optional: Google Places API key for India city search. Without it the API
# falls back to Open-Meteo geocoding, then a small built-in city list.
GOOGLE_PLACES_API_KEY=

# Optional weather provider; Open-Meteo is used by default and needs no key.
WEATHER_PROVIDER_URL=https://api.open-meteo.com/v1/forecast

# Cities refreshed by the scheduled cache job (used by refresh_cache.py).
PRICE_CACHE_CITIES=Delhi,Mumbai,Kolkata,Bengaluru,Chennai,Hyderabad,Pune,Ahmedabad,Jaipur,Lucknow,Patna,Bhopal
