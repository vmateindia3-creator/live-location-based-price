FLASK_ENV=development
PORT=8080
LOG_LEVEL=INFO

# Cache lifetimes (seconds).
CACHE_TTL_SECONDS=1800        # city prices: one upstream lookup per city per 30 min
GEOCODE_TTL_SECONDS=86400     # reverse geocode: 24 h
WEATHER_TTL_SECONDS=900       # weather: 15 min
CACHE_MAX_AGE_SECONDS=129600  # serve the scheduled file cache up to 36 h old

# Upstream protection: how hard the live scrape may hit the source site.
SCRAPE_MIN_INTERVAL_SECONDS=1.0
SCRAPE_MAX_CONCURRENCY=2

RATE_LIMIT_PER_MIN=120
# Comma-separated list of allowed browser origins, or * for any.
ALLOWED_ORIGINS=*

# Optional: Google Places API key for India city search.
GOOGLE_PLACES_API_KEY=

# Optional weather provider; Open-Meteo is used by default and needs no key.
WEATHER_PROVIDER_URL=https://api.open-meteo.com/v1/forecast

# Cities refreshed by the scheduled cache job (used by refresh_cache.py).
# Leave unset to use the built-in list of ~60 Indian cities.
PRICE_CACHE_CITIES=
